{
  "name": "chessir",
  "private": true,
  "version": "0.1.0",
  "description": "Chess with rotating board bands, rendered with three.js",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build",
    "match": "node scripts/match.js"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
